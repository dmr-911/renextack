# LaunchStack Next: example environment file.
# Copy to `.env` for local development:  cp .env.example .env
# Never commit real secrets. Full reference: docs/environment-variables.md

# --- Core (required) ---------------------------------------------------------
# Public base URL of the app. Used for auth callbacks and links in emails.
APP_URL=http://localhost:3000

# PostgreSQL. Neon is the recommended host (docs/neon.md):
#   Neon console -> Connect -> copy the pooled string ("Connection pooling" on)
#   into DATABASE_URL and the direct string (pooling off) into DATABASE_URL_UNPOOLED.
#   TLS and channel binding are applied automatically for neon.tech hosts.
# DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL_UNPOOLED=postgresql://neondb_owner:<password>@ep-xxxx.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# Offline alternative: local Postgres from docker-compose.yml (the default below).
DATABASE_URL=postgres://launchstack:launchstack@localhost:5432/launchstack
# Used by migrations, seed and reset when set; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Max connections per server process. Keep small (1-5) on serverless hosts.
DATABASE_POOL_MAX=10
# Force TLS for other hosted providers. Not needed for Neon (detected from the host).
DATABASE_SSL=false

# At least 32 random characters. Generate with: openssl rand -base64 32
# `npm run setup` replaces this placeholder with a generated value.
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string-of-32-chars-or-more

# debug | info | warn | error | silent
LOG_LEVEL=info

# database (works across instances) | memory (single process only)
RATE_LIMIT_STORE=database

# --- Local demo data (development only) ---------------------------------------
# Password for the seeded demo accounts. Seeding refuses to run in production.
SEED_DEMO_PASSWORD=demo-password-123

# --- Optional integrations (all off by default, no paid services needed) -------
# Email: console prints emails (e.g. password reset links) to the server log.
EMAIL_PROVIDER=console
EMAIL_FROM="LaunchStack <no-reply@example.com>"
RESEND_API_KEY=

# Payments: none | stripe (use sk_test_... keys while developing)
PAYMENTS_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# File storage: none | local (writes to STORAGE_LOCAL_DIR; not for serverless)
STORAGE_PROVIDER=none
STORAGE_LOCAL_DIR=.storage

# Analytics: none | console | posthog
ANALYTICS_PROVIDER=none
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# AI: none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
